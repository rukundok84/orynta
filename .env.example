# Copy to .env.local and fill in real values. .env.local is git-ignored.

# --- Database (required) ----------------------------------------------------
# Local PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/oryntra

# --- AI explanations (optional) ---------------------------------------------
# Without these, ORYNTA still works: explanations are produced by a free
# deterministic template and clearly labelled "Rule-based template".
# With them set, explanations become AI-generated (labelled with the model).
#
# Works with any OpenAI-compatible API: OpenAI, DeepSeek, Groq, OpenRouter,
# Mistral, or a local Ollama server.
# AI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# --- Auth sessions (required) ----------------------------------------------
# Secret used to sign auth session cookies (JWT, HS256).
# Generate your own with: openssl rand -base64 32
SESSION_SECRET=change_me_to_a_random_secret
